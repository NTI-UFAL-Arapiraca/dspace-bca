ARG DSPACE_ANGULAR_TAG=dspace-10.1
FROM docker.io/dspace/dspace-angular:${DSPACE_ANGULAR_TAG}

WORKDIR /app

# Keep the PDF viewer identical to the production image.
COPY frontend/patches/install-pdf-viewer.mjs /tmp/install-pdf-viewer.mjs
COPY frontend/overrides/pdf-range-viewer.mjs /tmp/pdf-range-viewer.mjs
RUN node /tmp/install-pdf-viewer.mjs /app/src/assets/pdfjs /tmp/pdf-range-viewer.mjs

# Keep the first paint consistent with the saved browser preference.
COPY frontend/overrides/color-mode-init.js /tmp/color-mode-init.js
COPY frontend/patches/apply-color-mode-init.mjs /tmp/apply-color-mode-init.mjs
RUN node /tmp/apply-color-mode-init.mjs /app/src/index.html /tmp/color-mode-init.js

# Apply the same source patches as the production build before ng serve starts.
COPY frontend/patches/apply-default-anonymous-language.mjs \
    /tmp/apply-default-anonymous-language.mjs
RUN node /tmp/apply-default-anonymous-language.mjs \
    /app/src/app/core/locale/locale.service.ts

COPY frontend/overrides/edit-item-all-languages.resolver.ts \
    /app/src/app/item-page/edit-item-page/edit-item-all-languages.resolver.ts
COPY frontend/patches/apply-item-all-languages.mjs /tmp/apply-item-all-languages.mjs
RUN node /tmp/apply-item-all-languages.mjs \
    /app/src/app/core/data/item-data.service.ts \
    /app/src/app/item-page/edit-item-page/edit-item-page-routes.ts

# Keep Person search navigation local to its results, including smooth scrolling.
COPY frontend/overrides/person-search-navigation*.ts /app/src/app/
COPY frontend/patches/apply-person-search-navigation.mjs /tmp/apply-person-search-navigation.mjs
RUN node /tmp/apply-person-search-navigation.mjs /app/src/app

COPY frontend/overrides/robots.txt.ejs /app/src/robots.txt.ejs
COPY frontend/overrides/privacy-content.component.html \
    /app/src/app/info/privacy/privacy-content/privacy-content.component.html
COPY frontend/dev/live-theme.mjs /app/dev/live-theme.mjs

# The official source image starts npm serve. The local entrypoint first copies
# changed theme files into that source tree, then starts the watcher.
ENTRYPOINT ["node", "/app/dev/live-theme.mjs"]
