# Copy to .env.development and use only with docker-compose-rest.yml plus
# docker-compose-dev.yml. The Compose project has separate local data volumes.
COMPOSE_PROJECT_NAME=d10dev
DSPACE_VER=dspace-10.1
DSPACE_NAME="Repositório Institucional Campus Arapiraca"
POSTGRES_PASSWORD=replace-with-a-local-random-password

# Existing local file and directory required by docker-compose-rest.yml.
GEOLITE2_CITY_DB_PATH=/absolute/path/to/GeoLite2-City.mmdb
DSPACE_SAF_HOST_DIR=/absolute/path/to/empty-saf-bundle
