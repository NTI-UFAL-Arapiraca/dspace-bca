# Copy to a private .env on the production host. Do not commit real values.
COMPOSE_PROJECT_NAME=d10
POSTGRES_PASSWORD=replace-with-a-long-random-password
GEOLITE2_CITY_DB_PATH=/srv/dspace/GeoLite2-City.mmdb
DSPACE_SAF_HOST_DIR=/srv/dspace/saf_bundle

# Public HTTPS URLs. The REST hostname must equal the host in DSPACE_SERVER_URL.
DSPACE_UI_URL=https://repositorio.example.edu.br
DSPACE_SERVER_URL=https://repositorio.example.edu.br/server
DSPACE_REST_HOST=repositorio.example.edu.br
DSPACE_ADMIN_EMAIL=biblioteca@example.edu.br
DSPACE_MAIL_SERVER=smtp.example.edu.br
DSPACE_MAIL_FROM=nao-responda@example.edu.br
