# Copy to a private .env on the production host. Do not commit real values.
COMPOSE_PROJECT_NAME=d10
POSTGRES_PASSWORD=replace-with-a-long-random-password
GEOLITE2_CITY_DB_PATH=/srv/dspace/GeoLite2-City.mmdb
DSPACE_SAF_HOST_DIR=/srv/dspace/saf_bundle
DSPACE_ANGULAR_IMAGE=ghcr.io/nti-ufal-arapiraca/dspace-bca-angular

# Browser-facing domain served by the external proxy. It may resolve only
# on the campus network. Its upstream is this DSpace server on HTTP port 80.
DSPACE_PUBLIC_ORIGIN=https://repo.interno.example.org
DSPACE_UI_URL=https://repo.interno.example.org/dspace
DSPACE_SERVER_URL=https://repo.interno.example.org/dspace-api
DSPACE_REST_HOST=repo.interno.example.org
DSPACE_ADMIN_EMAIL=biblioteca@example.org
DSPACE_MAIL_SERVER=smtp.example.org
DSPACE_MAIL_FROM=nao-responda@example.org
