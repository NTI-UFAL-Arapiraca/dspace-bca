# Advertise both DSpace sitemap formats using the configured public UI origin.
Sitemap: <%= origin %>/sitemap_index.xml
Sitemap: <%= origin %>/sitemap_index.html

User-agent: *

# Keep public item, handle, community, collection and file pages crawlable.
# Block dynamic, private and potentially expensive application areas.
Disallow: /dspace/search
Disallow: /dspace/admin/
Disallow: /dspace/processes
Disallow: /dspace/submit
Disallow: /dspace/workspaceitems
Disallow: /dspace/profile
Disallow: /dspace/workflowitems
Disallow: /dspace/entities/*?f
Disallow: /dspace/collections/*?f
Disallow: /dspace/communities/*?spc.page
